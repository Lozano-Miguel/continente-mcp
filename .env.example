# continentept-mcp settings.
# Save as ~/.continentept-mcp/credentials.env, or anywhere you point CONTINENTE_CREDENTIALS_FILE at.
# Keep it private (chmod 600). Values set in the MCP client environment take precedence.

# Account credentials for automatic sign-in. Not needed for search or product details.
CONTINENTE_EMAIL=you@example.com
CONTINENTE_PASSWORD=replace-with-your-password

# Close the browser after this many idle seconds; 0 keeps it open. Default: 300
# CONTINENTE_BROWSER_IDLE_SECONDS=300

# These two only work as environment variables in the MCP client configuration:
# CONTINENTE_CREDENTIALS_FILE=/private/path/credentials.env
# CONTINENTE_DATA_DIR=/private/path/continentept-mcp
